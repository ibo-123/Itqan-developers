# MongoDB Atlas (or local)
MONGODB_USERNAME=your_db_user
MONGODB_PASSWORD=your_db_password
MONGODB_URI=mongodb+srv://your_db_user:your_db_password@cluster0.xxxxx.mongodb.net/itqan-developers?retryWrites=true&w=majority

# Auth / session (generate long random secrets for production)
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_SESSION_COOKIE=itqan_admin_session

# Optional public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional contact / outbound email (Phase 3+)
CONTACT_EMAIL=contact@itqandevelopers.org

# Seed admin (used by npm run seed)
SEED_ADMIN_EMAIL=admin@itqan.local
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=ITQAN Super Admin
